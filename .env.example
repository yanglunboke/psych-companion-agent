# ============================================================
# 中学积极心理陪伴智能体 · 环境变量样例
# 复制为 .env 后按需修改；所有项都有默认值，缺省即可离线启动。
# ============================================================

# ---------- 服务 ----------
APP_NAME=中学积极心理陪伴智能体
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ---------- 模型后端 ----------
# mock   : 本地规则引擎，零依赖零密钥，可完整跑通全链路（默认）
# openai : 任意 OpenAI 兼容接口（OpenAI / DeepSeek / Moonshot / 通义 / Ollama / vLLM ...）
MODEL_PROVIDER=mock
MODEL_NAME=psych-companion-main
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=1024
MODEL_TIMEOUT=60

# 风险分专用小模型（文档：比主回复模型更小更快，temperature=0）
RISK_MODEL_NAME=psych-companion-risk
RISK_MODEL_BASE_URL=
RISK_MODEL_API_KEY=
RISK_MODEL_TEMPERATURE=0.0

# ---------- 安全门 ----------
# 风险分阈值，文档给定 0.72（宁误报勿漏报）
RISK_THRESHOLD=0.72
# 高危关键词词表（JSON 路径）
LEXICON_PATH=app/data/lexicon/high_risk_lexicon.json

# ---------- 记忆 ----------
# memory : 内置进程内实现（开发/测试默认）
# redis  : 真实 Redis（按学生聚合，可取跨会话最近 12 轮）
MEMORY_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
# Redis key 前缀：实际键形如 psych:student:<学号>:session:<会话>
REDIS_KEY_PREFIX=psych
# Postgres（情绪轨迹 / 心理侧写 / 对话原话）
POSTGRES_DSN=
# 短期记忆窗口：该生跨会话最近 12 轮
SHORT_TERM_TURNS=12
# 情绪强度指数平滑：新值 = 0.7 * 旧值 + 0.3 * 本轮
INTENSITY_EMA_ALPHA=0.3
# 认知偏差进入"稳定项"的证据次数阈值
PROFILE_EVIDENCE_THRESHOLD=3

# ---------- RAG 检索 ----------
# 召回：向量 + BM25 并行，各取 top-20
RECALL_TOP_K=20
# 向量余弦相似度下限，低于该值丢弃
VECTOR_MIN_SCORE=0.35
# RRF 常数 k
RRF_K=60
# 重排：Cross-Encoder 分数下限
RERANK_MIN_SCORE=0.45
# 重排后交给截断阶段的候选数
RERANK_TOP_K=20
# 各 intervention_fit 的动态 K（轻量引导只塞 2 张，省 token 预算）
DYNAMIC_K_BY_FIT={"只想说说":2,"情绪疏导":3,"轻量引导":2,"需要练习":4}
# 断崖截断：与第 2 名分差超过该值即舍弃后续
SCORE_GAP_THRESHOLD=0.15

# ---------- 高危上报 ----------
# escalate_risk 的真实投递地址；留空则写入本地 outbox（可查询）
ESCALATION_WEBHOOK_URL=
ESCALATION_OUTBOX_PATH=data/outbox/escalations.jsonl
# 老师端 / 家长端通知
TEACHER_NOTIFY_CHANNEL=teacher_console
PARENT_NOTIFY_CHANNEL=parent_console

# ---------- 调试接口 ----------
# 开启后可用 /debug/memory 页面与 /api/debug/* 查看某个会话的短期记忆窗口。
# 默认关闭：这些接口返回学生原话且没有鉴权，只应在可信的本机环境临时打开。
DEBUG_API_ENABLED=false

# ---------- 账号与登录 ----------
# 学生身份必须稳定（长期画像按 student_id 存），登录后由令牌给出。
AUTH_TOKEN_TTL_DAYS=30
# 首次用某个学号登录是否自动建号。
# 演示/测试用 true；正式上线请由校方导入名单后改为 false。
AUTH_AUTO_REGISTER=true

# ---------- 评测 ----------
EVAL_SEED=2026
